<Window x:Class="BoardGames.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="250" Width="350"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вход в систему" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="#2C3E50"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5" Foreground="#34495E"/>
            <TextBox x:Name="TxtLogin" Height="25" Margin="0,0,0,15" Padding="3,0,0,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5" Foreground="#34495E"/>
            <PasswordBox x:Name="TxtPassword" Height="25" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

            <Button x:Name="BtnLogin" Content="Войти" Height="30" Background="#34495E" Foreground="White" FontWeight="Bold" Click="BtnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>
